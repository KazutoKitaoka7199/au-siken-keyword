{
  "name": "ap-keyword-study",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "node --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "data:sync": "node --use-env-proxy scripts/sync-glossary.mjs",
    "data:verify": "node scripts/verify-data.mjs",
    "check": "npm run data:verify && npm test && npm run build"
  },
  "dependencies": {
    "@fontsource-variable/noto-sans-jp": "5.3.1",
    "lucide-react": "1.61.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@sparticuz/chromium": "153.0.0",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "cheerio": "1.2.0",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  }
}
